@charset "utf-8";

.flip-pic-news { float: right; }

.flip-pic-news ol, .flip-pic-news ul { list-style: none; }

.pro-switch { height: 220px; overflow: hidden; position: relative; width: 3=
19px; }

.flexslider { margin: 0px; padding: 0px; }

.flexslider .slides > li { display: none; backface-visibility: hidden; }

.flexslider .slides img { width: 100%; display: block; }

.slides::after { content: "."; display: block; clear: both; visibility: hid=
den; line-height: 0; height: 0px; }

html[xmlns] .slides { display: block; }

* html .slides { height: 220px; }

.no-js .slides > li:first-child { display: block; }

.flexslider { margin: 0px auto; position: relative; width: 319px; zoom: 1; =
}

.flex-viewport { max-height: 2000px; transition: 1s; }

.flexslider .slides { zoom: 1; }

.flex-direction-nav { }

.flex-direction-nav a { width: 60px; height: 90px; margin: -60px 0px 0px; d=
isplay: block; background: url("../images/ad_ctr.png") 0px 0px no-repeat; p=
osition: absolute; top: 50%; z-index: 10; cursor: pointer; text-indent: -99=
99px; opacity: 0; transition: 0.3s; }

.flex-direction-nav .flex-next { background-position: 0px -90px; right: 0px=
; }

.flex-direction-nav .flex-prev { left: 0px; }

.flexslider:hover .flex-next { opacity: 0.8; }

.flexslider:hover .flex-prev { opacity: 0.8; }

.flexslider:hover .flex-next:hover, .flexslider:hover .flex-prev:hover { op=
acity: 1; }

.flex-control-nav { width: 100%; position: absolute; bottom: 10px; text-ali=
gn: center; }

.flex-control-nav li { margin: 0px 5px; display: inline-block; zoom: 1; }

.flex-control-paging li a { background: url("../images/dot.png") 0px -16px =
no-repeat; display: block; height: 16px; overflow: hidden; text-indent: -99=
em; width: 16px; cursor: pointer; }

.flex-control-paging li a.flex-active { background-position: 0px 0px; }

#j_tslm { border-bottom: 1px solid rgb(226, 226, 227); margin-top: 22px; ov=
erflow: hidden; padding-bottom: 40px; }

.mod-tit { background: no-repeat; color: rgb(48, 50, 54); font-size: 28px; =
height: 50px; line-height: 50px; margin: 32px 0px; padding-left: 60px; }

.tszl { background-image: url("../images/tit_tslm.png"); }

.about { background-image: url("../images/tit_about.png"); }

.pro-list { font-size: 0px; }

.pro-list li { background-color: rgb(17, 180, 254); border: 4px solid rgb(2=
11, 213, 219); display: inline-block; height: 120px; margin-right: 38px; wi=
dth: 120px; }

.pro-list li.last { margin-right: 0px; }

.news-mod-cont { background-color: rgb(247, 247, 247); overflow: hidden; pa=
dding: 30px; }

.news-mod { width: 342px; }

.news-mod-tit { background: url("../images/line.png") 0px 100% no-repeat; c=
olor: rgb(62, 63, 67); font-size: 16px; font-weight: 700; margin-bottom: 15=
px; padding-bottom: 12px; }

.more, .fr { float: right; }

.more { color: rgb(22, 142, 255); text-decoration: none; }

.fl { float: left; }

.date { color: rgb(123, 123, 123); float: right; }

.txt-list li, .news-list li { color: rgb(62, 63, 67); display: block; paddi=
ng: 6px 0px; }

.news-list li a, .txt-list li a { color: rgb(44, 107, 166); text-decoration=
: none; }

.clearfix::after { content: ""; display: block; clear: both; }

.clearfix { zoom: 1; }

#j_tslm ul li { width: 128px; height: 128px; border: 0px; background-color:=
 transparent; }

#j_tslm ul a { width: 128px; height: 128px; display: block; position: relat=
ive; z-index: 0; text-decoration: none; }

#j_tslm ul div { position: absolute; top: 0px; left: 0px; width: 120px; hei=
ght: 120px; border: 4px solid rgb(211, 213, 219); }

#j_tslm a .front { z-index: 2; transform-style: preserve-3d; backface-visib=
ility: hidden; transition: -webkit-transform 0.3s linear; }

#j_tslm a .back { z-index: 1; transform: rotateY(-180deg); transform-style:=
 preserve-3d; backface-visibility: hidden; transition: -webkit-transform 0.=
3s linear; }

#j_tslm a:hover .front { transform: rotateY(180deg); }

#j_tslm a:hover .back { z-index: 3; zoom: 1; transform: rotateY(0deg); }

#footer { width: 950px; margin: 50px auto; text-align: center; line-height:=
 1.5; color: rgb(158, 158, 158); }

#footer a { color: rgb(158, 158, 158); text-decoration: none; }
