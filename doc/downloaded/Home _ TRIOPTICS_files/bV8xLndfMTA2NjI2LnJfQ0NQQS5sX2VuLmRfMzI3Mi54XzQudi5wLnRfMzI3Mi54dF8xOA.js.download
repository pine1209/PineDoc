if(!("strCustomCSS" in window.cmp_config_data) || window.cmp_config_data.strCustomCSS==""){window.cmp_config_data.strCustomCSS = "*.cmpboxdetails {\r\npadding-right: 15px;\r\n}\r\n.cmpfullscreen.cmpbox {\r\ntransform: none;\r\ntop: 0;\r\nleft: 0;\r\n}\r\n*.cmpbox {\r\ntransition: none!important;\r\n}.cmpbox:dir(rtl) *.cmpboxdetails, .cmpbox[dir=\"rtl\"] *.cmpboxdetails{padding-left:15px;padding-right:0;}.cmpbox:dir(rtl) .cmpfullscreen.cmpbox, .cmpbox[dir=\"rtl\"] .cmpfullscreen.cmpbox{right:0;left:auto;}.cmplogo {right: 10px; top: 5px;}.cmpbox:dir(rtl) .cmplogo, .cmpbox[dir=\"rtl\"] .cmplogo {left: 10px; top: 5px; right:auto;}@media (max-width: 570px){.cmplogo{ display: none !important;}}\n    @media (max-height: 926px) and (max-width: 480px) and (orientation: portrait){.cmplogo{display: none !important;}}\n    @media (max-width: 926px) and (max-height: 480px) and (orientation: landscape){.cmplogo{display: none !important;}} *.cmpboxhl{font-size:12pt;color:var(--clrHeadline);padding-bottom:10px;font-weight:bold;} *.cmpboxtxt, td.cmpvendname{font-size:10pt;color:#3B3B3B;}.cmpwelcomeprpstxt, .cmpwelcomeprpstxt A:link, .cmpwelcomeprpsbtn, .cmpwelcomeprpsbtn A:link, .cmpwelcomeprpsbtn span{font-size:10pt;color:#3B3B3B;} *.cmpboxtxt{padding-bottom:20px;}.cmpwelcomeprpstxt, .cmpwelcomeprpstxt A:link, .cmpwelcomeprpsbtn, .cmpwelcomeprpsbtn A:link, .cmpwelcomeprpsbtn span{font-size:10pt;color:#3B3B3B;}.cmpboxwelcomeprps{margin-bottom:20px;}.cmpmore{font-size:10pt;} .cmpsavemychoice, .cmpsavemychoice label{font-size:10pt;color:#3B3B3B;} .cmpmorelink, A.cmpmorelink, A.cmpmorelink:link, .cmpmore A, .cmpmore A:link{font-size:10pt;color:#3B3B3B;} .cmpsavemychoice, .cmpsavemychoice label{font-size:10pt;color:#3B3B3B;}  *.cmpboxbtnyes, A.cmpboxbtnyes, A.cmpboxbtnyes:link{font-size:12pt;color:var(--clrButtonText);background-color:#5AB14B;} *.cmpboxbtnno, A.cmpboxbtnno, A.cmpboxbtnno:link{font-size:12pt;color:var(--clrButtonText);background-color:#B8B8B8;} *.cmpboxbtnsave, A.cmpboxb